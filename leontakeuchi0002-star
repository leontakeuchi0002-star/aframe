<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <script src="https://aframe.io/releases/1.5.0/aframe.min.js"></script>
  </head>
  <body>
    <a-scene>
      <!-- 写真を半球の内側に貼る -->
      <a-curvedimage 
        src="BAC24FE6-A4CF-4CE8-80EB-EC00C69708CA.jpeg"
        radius="5"
        theta-length="180"
        height="3"
        rotation="0 180 0"
        position="0 1.6 0">
      </a-curvedimage>

      <!-- 視点（カメラ） -->
      <a-entity camera look-controls position="0 1.6 0"></a-entity>
    </a-scene>
  </body>
</html>
